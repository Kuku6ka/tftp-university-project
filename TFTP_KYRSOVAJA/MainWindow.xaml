<Window x:Class="TFTP_KYRSOVAJA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TFTP_KYRSOVAJA"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
	<Grid>
		<TabControl>
			<TabItem Header="Server">
				<Grid Margin="10">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
						<TextBlock Text="Root Directory:" VerticalAlignment="Center" Margin="0,0,5,0"/>
						<TextBox x:Name="ServerRootDirectoryTextBox" Width="300" Text="C:\TFTPRoot"/>
						<Button x:Name="BrowseServerDirectoryButton" Content="Browse..." Margin="5,0,0,0" Width="80" Click="BrowseServerDirectoryButton_Click"/>
					</StackPanel>

					<StackPanel Grid.Row="1" Orientation="Horizontal">
						<Button x:Name="StartServerButton" Content="Start Server" Width="100" Click="StartServerButton_Click"/>
						<Button x:Name="StopServerButton" Content="Stop Server" Width="100" Margin="5,0,0,0" Click="StopServerButton_Click" IsEnabled="False"/>
					</StackPanel>

					<TextBox x:Name="ServerLogTextBox" Grid.Row="2" Margin="0,10,0,0" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="Wrap"/>

					<Button x:Name="ClearServerLogButton" Grid.Row="3" Content="Clear Log" Width="100" Margin="0,10,0,0" HorizontalAlignment="Left" Click="ClearServerLogButton_Click"/>
				</Grid>
			</TabItem>

			<TabItem Header="Client">
				<Grid Margin="10">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
						<TextBlock Text="Server IP:" VerticalAlignment="Center" Margin="0,0,5,0"/>
						<TextBox x:Name="ServerIpTextBox" Width="150" Text="127.0.0.1"/>
					</StackPanel>

					<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
						<TextBlock Text="Remote File:" VerticalAlignment="Center" Margin="0,0,5,0"/>
						<TextBox x:Name="RemoteFileTextBox" Width="300"/>
					</StackPanel>

					<StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
						<TextBlock Text="Local File:" VerticalAlignment="Center" Margin="0,0,5,0"/>
						<TextBox x:Name="LocalFileTextBox" Width="300"/>
						<Button x:Name="BrowseLocalFileButton" Content="Browse..." Margin="5,0,0,0" Width="80" Click="BrowseLocalFileButton_Click"/>
					</StackPanel>

					<StackPanel Grid.Row="3" Orientation="Horizontal">
						<Button x:Name="DownloadButton" Content="Download" Width="100" Click="DownloadButton_Click"/>
						<Button x:Name="UploadButton" Content="Upload" Width="100" Margin="5,0,0,0" Click="UploadButton_Click"/>
					</StackPanel>

					<TextBox x:Name="ClientLogTextBox" Grid.Row="4" Margin="0,10,0,0" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="Wrap"/>

					<Button x:Name="ClearClientLogButton" Grid.Row="5" Content="Clear Log" Width="100" Margin="0,10,0,0" HorizontalAlignment="Left" Click="ClearClientLogButton_Click"/>
				</Grid>
			</TabItem>
		</TabControl>
	</Grid>
</Window>
